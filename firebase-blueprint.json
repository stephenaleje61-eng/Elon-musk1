{
  "entities": {
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Visitor membership and connection request to join the space community network",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "timestamp": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "location", "status", "timestamp"]
    },
    "Visitor": {
      "title": "Visitor",
      "description": "Visitor profile record in the community",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email"]
    },
    "PrivateChat": {
      "title": "PrivateChat",
      "description": "One-to-one private chat channel between visitor and admin",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "visitorId": { "type": "string" },
        "visitorName": { "type": "string" },
        "visitorEmail": { "type": "string" },
        "visitorLocation": { "type": "string" },
        "status": { "type": "string" },
        "lastMessage": { "type": "string" },
        "lastMessageTime": { "type": "string" },
        "lastSender": { "type": "string" },
        "adminUnreadCount": { "type": "number" },
        "visitorUnreadCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "visitorId", "visitorName", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Real message inside a private channel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["admin", "visitor"] },
        "senderName": { "type": "string" },
        "text": { "type": "string" },
        "imageUrl": { "type": "string" },
        "timestamp": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["id", "sender", "timestamp"]
    }
  },
  "firestore": {
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending and reviewed membership requests"
    },
    "/visitors/{visitorId}": {
      "schema": { "$ref": "#/entities/Visitor" },
      "description": "Registered visitor records"
    },
    "/privateChats/{chatId}": {
      "schema": { "$ref": "#/entities/PrivateChat" },
      "description": "Direct private conversation metadata"
    },
    "/privateChats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Encrypted real-time messages in a private channel"
    }
  }
}
