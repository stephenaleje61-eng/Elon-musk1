{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile details for a registered or anonymous user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 80 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "bio": { "type": "string", "maxLength": 500 },
        "isAnonymous": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "isAnonymous"]
    },
    "ScamReport": {
      "title": "ScamReport",
      "description": "User submitted incident report for scam investigation and official agency reporting",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "caseNumber": { "type": "string", "maxLength": 32 },
        "scamType": { "type": "string", "maxLength": 100 },
        "amountLost": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "incidentDate": { "type": "string", "maxLength": 30 },
        "paymentMethod": { "type": "string", "maxLength": 60 },
        "transactionReference": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 3000 },
        "evidenceUrls": { "type": "array" },
        "status": { "type": "string", "enum": ["submitted", "under_review", "escalated", "closed"] },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "caseNumber", "scamType", "amountLost", "currency", "incidentDate", "status"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct one-to-one secure chat between two verified platform sessions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "participants": { "type": "array" },
        "participantNames": { "type": "object" },
        "lastMessage": { "type": "string", "maxLength": 500 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "lastMessageAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "participants"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a private conversation",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "maxLength": 2000 },
        "imageUrl": { "type": "string", "maxLength": 2048 },
        "status": { "type": "string", "enum": ["sent", "delivered", "read"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "conversationId", "senderId", "text"]
    },
    "UserReport": {
      "title": "UserReport",
      "description": "Safety report submitted against abusive or spam content",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reporterId": { "type": "string", "maxLength": 128 },
        "targetUserId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["pending", "reviewed", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "reporterId", "targetUserId", "reason"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profile and identity metadata"
    },
    "/scam_reports/{reportId}": {
      "schema": { "$ref": "#/entities/ScamReport" },
      "description": "User submitted financial scam incidents and recovery status tracking"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct private conversations between authenticated platform sessions"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a specific conversation"
    },
    "/user_reports/{reportId}": {
      "schema": { "$ref": "#/entities/UserReport" },
      "description": "Abuse and safety reports submitted by community members"
    }
  }
}
